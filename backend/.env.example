# JWT Secret (CHANGE THIS IN PRODUCTION!)
ACCESS_TOKEN_SECRET=ch4ng3_m3_pl34s3_t0_s0m3th1ng_s3cur3_n0w_p13ase!

# CORS Configuration - Multiple Origins Support
# Format: comma-separated list of URLs
# Supports: exact URLs, domain patterns, and regex patterns
# Examples:
#   http://localhost:5173, http://localhost:5174, http://localhost:3000
#   https://example.com, https://www.example.com
#   /^https:\/\/(www\.)?example\.com(:\d+)?$/ (for regex)
CORS_ORIGINS=http://localhost:5173, http://localhost:5174, http://localhost:3000

# For Production - uncomment and adjust:
# CORS_ORIGINS=/^https:\/\/(www\.)?yourdomain\.com$/, https://api.yourdomain.com
