# ============================================
# .gitignore for RebuildV2
# ============================================
# Optimized for CI/CD workflow with dev/main branches
# ============================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Environment files (SENSITIVE!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
spmb/frontend/.env
website/frontend/.env

# Build outputs (will be generated by CI/CD)
dist/
build/
prod-build/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Testing
coverage
.nyc_output

# IDE and Editors
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Temporary files
tmp/
temp/
*.tmp
*.cache

# Docker
.docker/

# Uploads (keep structure, ignore files)
backend/uploads/*
!backend/uploads/.gitkeep
public/website/*
!public/website/.gitkeep
public/spmb/*
!public/spmb/.gitkeep

# Database dumps (optional - uncomment if needed)
# *.sql
# !migrate_*.sql

# Secrets and keys
*.pem
*.key
secrets/

# Misc
*.tgz
.npm
.eslintcache
